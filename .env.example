# ============================================
# Trading Dashboard — env template
# Copy this file to `.env.local` and fill in your own keys.
# DO NOT commit .env.local — it contains personal credentials.
# ============================================

# EIA (Energy Information Administration) — FREE
# Register at: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# BLS (Bureau of Labor Statistics) — FREE, 500 req/day
# Register at: https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# FRED (Federal Reserve Economic Data) — FREE, 120 req/min
# Register at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# (Optional) MarineTraffic — paid (~$50/mo), enables live Hormuz vessel tracking
# MARINE_TRAFFIC_API_KEY=

# ── TELEGRAM (real-time oil channel news) ───────────────────────
# 1. Get api_id + api_hash at https://my.telegram.org → API development tools
# 2. Run `npm run telegram:setup` to authenticate (interactive — phone + SMS code)
# 3. Paste the printed TELEGRAM_SESSION line below
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
